#: healthCheck.py:385
msgid "Harmless notice"
msgstr "Pemberitahuan tidak berbahaya"

#: healthCheck.py:347
msgid "If it keeps happening while you use one program, that program has an accessibility problem."
msgstr "Jika masalah ini terus terjadi saat Anda menggunakan satu program tertentu, program tersebut memiliki masalah aksesibilitas."

#: healthCheck.py:358
msgid "It works for now but may stop working after a future NVDA update. The add-on author should update it."
msgstr "Berfungsi untuk sekarang tetapi mungkin berhenti berfungsi setelah pembaruan NVDA mendatang. Pembuat pengaya harus memperbaruinya."

#: crash_analyzer.py:423
msgid "Log file not found."
msgstr "Berkas log tidak ditemukan."

#: healthCheck.py:338
msgid "Many add-ons or a slow disk can cause this. Binary Search Debugging can help find a slow add-on."
msgstr "Banyak pengaya atau diska lambat dapat memicu hal ini. Debugging Pencarian Biner dapat membantu menemukan pengaya yang lambat."

#: doctor.py:277
msgid "Missing {n} configuration files"
msgstr "Kehilangan {n} berkas konfigurasi"

#: addonCore.py:114
msgid "NVDA Version: {}"
msgstr "Versi NVDA: {}"

#: healthCheck.py:344
msgid "NVDA could not look inside a protected Windows process. This is normal and harmless."
msgstr "NVDA tidak dapat memeriksa proses Windows yang dilindungi. Ini adalah hal yang normal dan tidak berbahaya."

#: healthCheck.py:349
msgid "NVDA has no separate keyboard command map for your language, so the default commands are used. This is normal."
msgstr "NVDA tidak memiliki pemetaan perintah keyboard terpisah untuk bahasa Anda, jadi perintah default yang akan digunakan. Ini adalah hal yang normal."

#: crash_analyzer.py:244
msgid "NVDA health findings:"
msgstr "Temuan kesehatan NVDA:"

#: healthCheck.py:428
msgid "NVDA health: good."
msgstr "Kesehatan NVDA: baik."

#: healthCheck.py:426
msgid "NVDA health: mostly good, with minor issues."
msgstr "Kesehatan NVDA: sebagian besar baik, dengan sedikit masalah."

#: healthCheck.py:424
msgid "NVDA health: needs attention."
msgstr "Kesehatan NVDA: perlu perhatian."

#: healthCheck.py:326
msgid "NVDA stopped responding and the log ends before it recovered. NVDA was probably closed or restarted while frozen."
msgstr "NVDA berhenti merespons dan log berakhir sebelum pulih. NVDA kemungkinan ditutup atau dimulai ulang saat macet."

#: healthCheck.py:324
msgid "NVDA stopped responding for about {seconds:.1f} seconds and then recovered."
msgstr "NVDA berhenti merespons selama sekitar {seconds:.1f} detik lalu pulih kembali."

#: healthCheck.py:337
msgid "NVDA took {seconds:.1f} seconds to start, which is slower than normal."
msgstr "NVDA memerlukan waktu {seconds:.1f} detik untuk memulai, yang lebih lambat dari biasanya."

#: healthCheck.py:335
msgid "NVDA was busy inside {module} (line {line})."
msgstr "NVDA sedang sibuk di dalam {module} (baris {line})."

#: healthCheck.py:333
msgid "NVDA was waiting for the program in front of you to answer an accessibility request. That program is probably the cause."
msgstr "NVDA sedang menunggu program di depan Anda untuk merespons permintaan aksesibilitas. Program tersebut mungkin menjadi penyebabnya."

#: cleanup.py:120
msgid "No __pycache__ folders found. Everything is clean."
msgstr "Tidak ada folder __pycache__ ditemukan. Semuanya bersih."

#: diagnostic.py:85
msgid "No active add-ons found to diagnose."
msgstr "Tidak ada pengaya aktif yang ditemukan untuk didiagnosis."

#: cleanup.py:104
msgid "No add-on directories found to clean."
msgstr "Tidak ada direktori pengaya yang ditemukan untuk dibersihkan."

#: crash_analyzer.py:433
msgid "No problems found in the NVDA log. For more thorough detection, consider setting NVDA's Logging Level to Debug in General Settings."
msgstr "Tidak ada masalah yang ditemukan pada log NVDA. Untuk deteksi yang lebih menyeluruh, pertimbangkan untuk mengatur Level Pencatatan (Logging Level) NVDA ke Debug di Pengaturan Umum."

#: crash_analyzer.py:431
msgid "No problems found in the NVDA log. NVDA looks healthy."
msgstr "Tidak ada masalah yang ditemukan pada log NVDA. NVDA tampak normal."

#: recovery_gui.py:175
msgid "No recovery points available. Create a recovery first."
msgstr "Tidak ada titik pemulihan yang tersedia. Buat pemulihan terlebih dahulu."

#: recovery_gui.py:94
msgid "No selection"
msgstr "Tidak ada pilihan"

#: cleanup.py:160
#: cleanup.py:201
msgid "No temporary or .delete NVDA files found."
msgstr "Tidak ada berkas sementara atau .delete NVDA yang ditemukan."

#: recovery_gui.py:94
msgid "Please select a recovery folder first."
msgstr "Silakan pilih folder pemulihan terlebih dahulu."

#: diagnostic.py:102
msgid "Ready to start diagnostic? NVDA will restart and disable half of your active add-ons."
msgstr "Siap memulai diagnostik? NVDA akan memuat ulang dan me-nonaktifkan separuh dari pengaya aktif Anda."

