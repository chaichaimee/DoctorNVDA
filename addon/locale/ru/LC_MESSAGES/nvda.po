msgid "DoctorNVDA Menu"
msgstr "Меню DoctorNVDA"

#: addonCore.py:127
msgid "Emergency Synthesizer Reboot"
msgstr "Аварийная перезагрузка синтезатора"

#: recovery_gui.py:144
msgid "Error"
msgstr "Ошибка"

